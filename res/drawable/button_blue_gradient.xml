<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:startColor="#449def" android:endColor="#449def" android:angle="270.0" android:centerColor="#2f6699" />
            <stroke android:width="1.0dp" android:color="#2f6699" />
            <corners android:radius="2.0dp" />
            <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#449def" />
            <stroke android:width="1.0dp" android:color="#2f6699" />
            <corners android:radius="2.0dp" />
            <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
        </shape>
    </item>
</selector>
