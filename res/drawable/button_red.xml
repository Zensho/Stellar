<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ef4444" />
            <stroke android:width="1.0dp" android:color="#992f2f" />
            <corners android:radius="3.0dp" />
            <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#ef4444" android:endColor="#992f2f" android:angle="270.0" />
            <stroke android:width="1.0dp" android:color="#992f2f" />
            <corners android:radius="3.0dp" />
            <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
        </shape>
    </item>
</selector>
